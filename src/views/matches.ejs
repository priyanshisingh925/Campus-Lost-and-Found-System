<%- include('partials/header') %>

<div class="crumbs"><a href="/admin">Dashboard</a> <span class="sep">/</span> Possible Matches</div>

<h1>Possible Matches</h1>
<p class="sub muted">Reports with a match score of 50 or higher, highest first. Click a row to review side by side.</p>

<% if (notice) { %><div class="notice ok"><%= notice %></div><% } %>

<div class="filters">
  <a class="chip <%= status === 'Pending' ? 'active' : '' %>" href="/admin/matches">Pending</a>
  <a class="chip <%= status === 'RESOLVED' ? 'active' : '' %>" href="/admin/matches?status=RESOLVED">Resolved</a>
  <a class="chip <%= status === 'REJECTED' ? 'active' : '' %>" href="/admin/matches?status=REJECTED">Rejected</a>
  <a class="chip <%= status === 'ALL' ? 'active' : '' %>" href="/admin/matches?status=ALL">All</a>
</div>

<% if (matches.length) { %>
  <div class="tablewrap">
  <table>
    <tr><th class="num">Score</th><th>Lost Item</th><th>Found Item</th><th>Lost Date</th><th>Found Date</th><th>Status</th></tr>
    <% matches.forEach(m => { %>
      <tr class="rowlink" data-href="/admin/matches/<%= m.match_id %>">
        <td class="num"><span class="score-pill <%= Math.round(m.match_score) >= 80 ? 'score-hi' : Math.round(m.match_score) >= 60 ? 'score-mid' : 'score-lo' %>"><%= Math.round(m.match_score) %>%</span></td>
        <td><b><%= m.lost_item %></b><br><span class="muted small">#<%= m.lost_id %></span></td>
        <td><b><%= m.found_item %></b><br><span class="muted small">#<%= m.found_id %></span></td>
        <td class="nowrap"><%= m.lost_date %></td>
        <td class="nowrap"><%= m.found_date %></td>
        <td><span class="badge <%= String(m.match_status).toLowerCase() %>"><%= m.match_status %></span></td>
      </tr>
    <% }) %>
  </table>
  </div>
<% } else { %>
  <div class="notice info">
    No matches with this status right now.
    <% if (status === 'Pending') { %> Submit a lost or found report, or add a box entry, and the system will generate matches automatically.<% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
