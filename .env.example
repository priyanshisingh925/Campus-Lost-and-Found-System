# Copy this file to .env and adjust the values.

PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=campus_lost_found

# Session cookie secret (change this to any random string)
SESSION_SECRET=change-me-to-a-random-string

# Minimum match score (0-100) stored/shown as a possible match
MATCH_THRESHOLD=50
